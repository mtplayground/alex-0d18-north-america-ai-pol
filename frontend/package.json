    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@testing-library/react": "16.3.2",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",

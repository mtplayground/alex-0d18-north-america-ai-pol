# Required by the HTTP backend and ingestion worker.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/policy_workspace

# HTTP backend (optional values shown with their defaults).
LISTEN_ADDRESS=0.0.0.0:8080
FRONTEND_DIST_DIR=frontend/dist

# S3-compatible raw source storage
OBJECT_STORAGE_ACCESS_KEY_ID=example-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=example-secret-key
OBJECT_STORAGE_BUCKET=policy-workspace
OBJECT_STORAGE_PREFIX=raw-snapshots
OBJECT_STORAGE_ENDPOINT=https://fly.storage.tigris.dev
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# AI summarizer
AI_SUMMARIZER_API_KEY=example-api-key
AI_SUMMARIZER_BASE_URL=https://api.example.com/v1
AI_SUMMARIZER_MODEL=example-summary-model
AI_SUMMARIZER_TIMEOUT_SECONDS=20

# Ingestion worker. 86400 is one daily pass after its immediate startup pass.
SCHEDULER_CADENCE_SECONDS=86400
